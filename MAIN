import random

answers = [
    "Yes definitely.",
    "Ask again later.",
    "Without a doubt.",
    "Very doubtful.",
    "Most likely.",
    "Reply hazy, try again.",
    "My sources say no.",
    "Outlook good.",
    "Signs point to yes.",
    "Concentrate and ask again."
]

ball = r'''
              .-""""-.
            .'        '.
           /            \\
          ;   .------.   ;
          |  /        \\  |
          | |  MAGIC   | |
          | |    8     | |
          | |   BALL   | |
          |  \\________/  |
          ;              ;
           \\            /
            '.        .'
              '-.__.-'
'''

print(ball)
print("Ask the Magic 8 Ball a question (or type 'quit' to exit).")

while True:
    question = input("\nYour question: ").strip()

    if question.lower() in {"quit", "exit"}:
        print("The Magic 8 Ball says: Goodbye!")
        break

    if not question:
        print("Please ask a question first!")
        continue

    answer = random.choice(answers)
    print("\nThe Magic 8 Ball says:")
    print("       .----------------------.")
    print(f"       | {answer:<20} |")
    print("       '----------------------'")
